[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Rioagusto1808/atpro-old.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "refactor/security-cleanup"]
	remote = origin
	merge = refs/heads/refactor/security-cleanup
	vscode-merge-base = origin/refactor/security-cleanup
